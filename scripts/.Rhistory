rm(list = ls())
library(tidyverse)
outlier <- function(x, y = 3){ #x = data column, y = 3 SD threshold by default
j <- vector()
for (i in 1:length(x)){
if (is.na(x[i])) {j[i]=NA}
else if (x[i] > (mean(x, na.rm=TRUE))+(y*(sd(x, na.rm=TRUE)))) {j[i] <- NA}
else if (x[i] < (mean(x, na.rm=TRUE))-(y*(sd(x, na.rm=TRUE)))) {j[i] <- NA}
else {j[i] <- x[i]}
}
j
}
pulse <- read_csv("data/optical_prefx_data.csv") # read prefx data
